# 웹에서 쓰는 환경변수. 값을 채워 web/.env.local로 복사한 뒤 dev를 다시 띄운다.
# 배포는 Vercel 프로젝트 설정 → Environment Variables에 같은 이름으로 넣는다.
#
# 없어도 서비스는 그대로 돈다. 지표 정확도 피드백만 테이블 대신 런타임
# 로그로 흘러간다.

# Supabase 프로젝트 URL — https://<ref>.supabase.co
# 대시보드 → Project Settings → API
SUPABASE_URL=

# anon(public) 키.
# 이 키로 할 수 있는 일은 accuracy_feedback에 한 줄 넣는 것뿐이다 —
# 테이블이 RLS로 insert만 열려 있다(supabase/migrations/0001_accuracy_feedback.sql).
# service_role 키는 RLS를 통째로 지나치므로 여기 넣지 말 것.
SUPABASE_ANON_KEY=
