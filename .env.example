# 농사로(nongsaro.go.kr) Open API 인증키 - data.go.kr과 별개로 nongsaro.go.kr 회원가입 후 발급
NONGSARO_API_KEY=

# 전남관광플랫폼(J-TaaS) redtable.global 인증키
# https://jeonnam.openapi.redtable.global/register 에서 이메일 가입 시 자동발급
JEONNAM_REDTABLE_API_KEY=

# 광주 대표 음식 정보 DB(redtable.global) 인증키
# https://gwangju.openapi.redtable.global/register 에서 이메일 가입 시 자동발급
GWANGJU_REDTABLE_API_KEY=

# 국립수산물품질관리원(nfqs.go.kr) 인증키 - 품질인증수산물/지리적표시수산물 API
# https://www.nfqs.go.kr/hpmg/api/actionApiDetail.do?apiCd=003 에서 신청
NFQS_API_KEY=

# 한국관광공사 TourAPI(KorService2) 일반 인증키
# https://www.data.go.kr/data/15101578/openapi.do 에서 활용신청(개발단계 자동승인)
TOURAPI_SERVICE_KEY=

# Anthropic API 키 - 맛 프로파일 LLM 보정(src/taste/llm_refine.py)에만 사용
# 없어도 룰 엔진만으로 파이프라인이 끝까지 동작한다.
# https://console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=

# 화면이 받은 지표 정확도 피드백을 되읽을 때만 쓴다(src/taste/feedback_review.py).
# 넣기는 웹의 anon 키로 열려 있지만 읽기는 RLS로 닫아 두어 service_role이 필요하다.
# 없으면 그 스크립트만 건너뛰고 나머지 파이프라인은 그대로 돈다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
